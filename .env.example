# 应用镜像。先运行 ./scripts/build-image.sh --push 推送到自己的镜像仓库。
OKX_APP_IMAGE=registry.example.com/your-namespace/okx-quant:2026.08.11
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=8080
TZ=Asia/Shanghai
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -Dfile.encoding=UTF-8

# MySQL 由 Docker Compose 创建；数据库不会暴露宿主机端口。
MYSQL_IMAGE_TAG=8.4
MYSQL_DATABASE=OKX
MYSQL_USERNAME=okx
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-another-strong-root-password

# 首次管理员和凭据加密主密钥。主密钥可用 openssl rand -base64 32 生成，必须稳定备份。
QUANT_AUTH_USERNAME=admin
QUANT_AUTH_PASSWORD=replace-with-a-strong-admin-password
QUANT_AUTH_SESSION_TTL_MINUTES=480
QUANT_CREDENTIAL_MASTER_KEY=replace-with-base64-encoded-32-byte-key

# 默认禁止交易。LIVE 还需要填写下方人工确认值。
TRADING_MODE=DISABLED
QUANT_AGENT_AUTO_TRADE_ENABLED=false
LIVE_DEPLOY_CONFIRM=

# 新开仓绝对上限为 3；震荡行情默认最多 2 仓，高波动默认只允许 1 仓。
QUANT_AGENT_MAX_OPEN_POSITIONS=3
QUANT_AGENT_MIN_OPEN_POSITIONS=3
QUANT_AGENT_MAX_POSITIONS_BULLISH=3
QUANT_AGENT_MAX_POSITIONS_BEARISH=3
QUANT_AGENT_MAX_POSITIONS_CHOPPY=2
QUANT_AGENT_MAX_POSITIONS_HIGH_VOLATILITY=1
QUANT_AGENT_MAX_LEVERAGE=10
QUANT_CONTRACT_MAX_LEVERAGE=10

# RMB 仅用于界面换算：启动时及每天北京时间 00:05 从 ECB 更新，失败保留上次成功值。
QUANT_SYSTEM_FX_ENABLED=true
QUANT_SYSTEM_FX_USD_CNY_RATE=7.0
QUANT_SYSTEM_FX_USD_CNY_SOURCE=FALLBACK
QUANT_SYSTEM_FX_URL=https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml
QUANT_SYSTEM_FX_FALLBACK_URL=https://api.frankfurter.app/latest?from=USD&to=CNY
QUANT_SYSTEM_FX_CONNECT_TIMEOUT_SECONDS=3
QUANT_SYSTEM_FX_READ_TIMEOUT_SECONDS=5
QUANT_SYSTEM_FX_REFRESH_CRON=0 5 0 * * *
QUANT_SYSTEM_FX_ZONE=Asia/Shanghai

# 新闻源：OKX 官方下架公告；如需禁用真实源可改为 NOOP。
QUANT_NEWS_PROVIDER=OKX

# 可选：也可以登录系统后按用户绑定 OKX 凭据。
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# 可选：AI 分析服务。默认使用 OpenAI-compatible Chat Completions；使用 Jev 时将 AI_PROVIDER 改为 TYPESAFE。
AI_PROVIDER=OPENAI_COMPATIBLE
AI_API_KEY=
AI_BASE_URL=https://api.moonshot.cn/v1
AI_MODEL=kimi-k2.6
AI_REQUEST_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=0

# TypeSafe Jev：只填写根目录 .env，不要写入 application.yml 或提交到仓库。
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest
QUANT_AGENT_AI_SELECTION_ENABLED=true
QUANT_AGENT_AI_SELECTION_CANDIDATE_LIMIT=12
# 评分门槛：保留流动性、新闻、资金费率、盈亏比等硬风控，放宽纯评分门槛。
QUANT_AGENT_AUTO_TRADE_MIN_SCORE=65
QUANT_AGENT_MIN_TOTAL_SCORE=65
QUANT_AGENT_MIN_FINAL_RANK_SCORE=65
QUANT_AGENT_NEWS_RISK_MISSING_DATA_SCORE=70
QUANT_AGENT_MIN_NEWS_RISK_RAW_SCORE=70
QUANT_AGENT_POSITION_MIN_SCORE_0=65
QUANT_AGENT_POSITION_MIN_SCORE_1=65
QUANT_AGENT_POSITION_MIN_SCORE_2=65
QUANT_AGENT_POSITION_MIN_FINAL_RANK_0=65
QUANT_AGENT_POSITION_MIN_FINAL_RANK_1=65
QUANT_AGENT_POSITION_MIN_FINAL_RANK_2=65

# 可选：Telegram 仅出站通知，不支持机器人远程交易命令。
NOTIFICATION_ENABLED=false
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SEND_TIMEOUT_SECONDS=8
TELEGRAM_MAX_ATTEMPTS=5

# deploy.sh 等待容器健康的最长秒数。
DEPLOY_WAIT_SECONDS=240
