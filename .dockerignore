# Only send the inputs consumed by the root Dockerfile.
**
!Dockerfile
!pom.xml
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig*.json
!frontend/vite.config.ts
!frontend/src/**/*.ts
!frontend/src/**/*.tsx
!frontend/src/i18n.en.json
!src/main/java/**/*.java
!src/main/resources/application.properties
!src/main/resources/application.yml
!src/main/resources/application-local.yml
!src/main/resources/application-miren.yml
!src/main/resources/META-INF/spring.factories
!src/main/resources/coingecko-okx-coin-ids.properties
!src/main/resources/db/migration/V*__*.sql
!akshare-service/requirements.txt
!akshare-service/server.py
!scripts/start-miren.sh
